{
  "info": {
    "_postman_id": "a918e62d-8b01-49cf-8987-a2c3dbf94111",
    "name": "Alumni API — Invalid Requests Test Suite",
    "description": "Comprehensive suite of negative / invalid request test cases for Istanbul University Alumni Tracking System (Assoc. Prof. Dr. Emre Akadal - Web Programming). Covers HTTP 400, 404, 409, and 415 error handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. 400 Bad Request — Missing Required Field (Name)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"noname@iu.edu.tr\",\n  \"graduationYear\": 2024\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users"]
        },
        "description": "Attempt to create a user without providing the required 'name' field."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Error mentions missing Name\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(JSON.stringify(jsonData)).to.include(\"Name\");",
              "});"
            ]
          }
        }
      ]
    },
    {
