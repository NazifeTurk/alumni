    {
      "name": "9. 409 Conflict — Duplicate Job Application (Slide Sec A)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/jobs/10/applications",
          "host": ["{{baseUrl}}"],
          "path": ["api", "jobs", "10", "applications"]
        },
        "description": "Classroom Slide Section A: UNIQUE (user_id, job_posting_id) -> applying twice returns 409 Conflict."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 409 Conflict\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test(\"Conflict message for duplicate application\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.include(\"already applied\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. 409 Conflict — Delete User with Job Postings (ON DELETE RESTRICT)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "1"]
        },
        "description": "Week 06 Delete Rule: Ada (ID: 1) has active job postings. ON DELETE RESTRICT prevents silent cascading deletion and returns 409 Conflict."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 409 Conflict\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test(\"Message cites RESTRICT constraint\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.include(\"RESTRICT\");",
              "});"
            ]
          }
        }
      ]
    },
