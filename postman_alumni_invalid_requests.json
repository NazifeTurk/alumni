    {
      "name": "5. 404 Not Found — Get Non-Existent User ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/99999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "99999"]
        },
        "description": "Querying a user that does not exist in the database."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404 Not Found\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test(\"Response has error: 404\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.eql(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
